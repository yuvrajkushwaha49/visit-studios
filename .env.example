# ========================================================
# Visit Studio — Production Environment Configuration
# ========================================================

# Server Runtime
PORT=3000
NODE_ENV=production

# Base Public URL (e.g. https://your-domain.com or https://your-tunnel.trycloudflare.com)
BASE_URL=http://localhost:3000

# Security: Replace with a cryptographically random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Allowed CORS Origins (e.g. https://your-domain.com or * for all)
CORS_ORIGIN=*

# Embedded SQLite Database Path (Defaults to server/data/visit_studio.db)
DB_PATH=./server/data/visit_studio.db

# Optional Enterprise Dual-Sync MySQL Database (Leave empty if using standalone SQLite)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=visit_studio_db

# Meta WhatsApp Cloud API (Optional - for direct automated WhatsApp delivery)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
